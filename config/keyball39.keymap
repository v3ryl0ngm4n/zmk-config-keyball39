#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    flavor = "balanced";
    quick-tap-ms = <150>;
    tapping-term-ms = <180>;
};

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
    tapping-term-ms = <180>;
};

/ {
    // custom shift using mod-morph 

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_blt_layer {
            bindings = <&mo 7>;
            key-positions = <34 37>;
            layers = <0>;
        };

        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <35 36>;
            layers = <0>;
        };
    };

    behaviors {
        layer_mkp: layer_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "Momentary Layer/Mouse Key Press";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Char";
            bindings = <
&kp Q    &kp W              &kp E           &kp R        &kp T                                 &kp Y            &kp U        &kp I            &kp O        &kp P
&kp Q    &mt LCTRL S        &mt LEFT_ALT D  &mt LSHFT F  &mt LEFT_GUI G                        &mt RIGHT_GUI H  &mt LSHFT J  &mt RIGHT_ALT K  &mt RCTRL L  &kp P
&kp A    &kp X              &kp C           &kp V        &kp B                                 &kp N            &kp M        &kp COMMA        &kp DOT      &lt 8 SEMICOLON
&lt 4 Z  &layer_mkp 4 RCLK  &mkp MB1        &lt 3 ESC    &lt 1 SPACE     &kp SPACE  &lt 3 TAB  &lt 2 RET                                                   &kp SLASH
            >;
        };

        number_layer {
            label = "Num";
            bindings = <
&trans        &kp N7              &kp N8           &kp N9  &kp N0                    &trans         &kp N7                   &kp N8           &kp N9              &kp N0
&trans        &mt LCTRL NUMBER_4  &mt LEFT_ALT N5  &kp N6  &kp BSPC                  &kp BACKSPACE  &mt LEFT_SHIFT NUMBER_4  &mt LEFT_ALT N5  &mt RCTRL NUMBER_6  &kp N0
&kp LEFT_GUI  &kp N1              &kp N2           &kp N3  &kp DEL                   &kp DELETE     &kp N1                   &kp N2           &kp N3              &trans
&trans        &trans              &trans           &trans  &trans    &trans  &trans  &trans                                                                       &trans
            >;
        };

        symbol_layer {
            label = "Sym";
            bindings = <
&kp EXCL         &kp AT  &kp HASH  &kp DOLLAR            &kp PERCENT                  &kp CARET       &kp AMPS              &kp KP_MULTIPLY            &kp LEFT_PARENTHESIS            &kp RIGHT_PARENTHESIS
&kp EXCLAMATION  &kp S   &trans    &mt LEFT_SHIFT GRAVE  &kp SQT                      &kp MINUS       &mt LEFT_SHIFT EQUAL  &mt LEFT_ALT LEFT_BRACKET  &mt LEFT_CONTROL RIGHT_BRACKET  &kp RIGHT_PARENTHESIS
&kp A            &trans  &trans    &trans                &kp TILDE                    &kp UNDERSCORE  &kp PLUS              &kp LEFT_BRACE             &kp RIGHT_BRACE                 &kp BACKSLASH
&trans           &trans  &trans    &trans                &trans       &trans  &trans  &trans                                                                                           &kp PIPE
            >;
        };

        function_layer {
            label = "F";
            bindings = <
&trans     &kp F7  &kp F8  &kp F9  &kp F10                  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp F4  &kp F5  &kp F6  &kp F11                  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp F1  &kp F2  &kp F3  &kp F12                  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans   &trans  &trans  &trans                          &trans
            >;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans      &trans     &mkp MB4   &mkp MB5   &trans                &trans         &trans     &trans     &trans     &trans
&trans      &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans                &kp PAGE_UP    &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MCLK
&kp ESCAPE  &trans     &trans     &trans     &trans                &kp PAGE_DOWN  &trans     &trans     &trans     &trans
&trans      &trans     &trans     &trans     &mo 6   &mo 5  &to 0  &kp ENTER                                       &trans
            >;
        };

        scroll_layer {
            label = "Scrl";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "Snipe";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        bluetooth_layer {
            bindings = <
&trans  &trans        &trans        &trans        &trans                  &trans  &trans      &trans        &trans        &trans
&trans  &trans        &bt BT_SEL 3  &bt BT_SEL 4  &trans                  &trans  &bt BT_CLR  &out OUT_BLE  &out OUT_USB  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                  &trans  &trans      &trans        &trans        &trans
&trans  &trans        &trans        &trans        &trans  &trans  &trans  &trans                                          &trans
            >;

            label = "Blt";
        };

        navigation_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans         &kp PAGE_UP     &kp UP_ARROW  &trans     &trans
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_DOWN  &trans          &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans
            >;

            label = "Nav";
        };
    };
};
